generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["customs", "macro_data", "public", "sector", "trade"]
}

model kam_sector {
  id          Int              @id @default(autoincrement())
  name        String           @db.VarChar(100)
  slug        String           @unique @db.VarChar(100)
  description String?
  icon        String?          @db.VarChar(50)
  color       String?          @db.VarChar(7)
  is_active   Boolean          @default(true)
  sort_order  Int              @default(0)
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  contents    kam_content[]
  sub_sectors kam_sub_sector[]

  @@schema("public")
}

model kam_sub_sector {
  id          Int           @id @default(autoincrement())
  sector_id   Int
  name        String        @db.VarChar(100)
  slug        String        @db.VarChar(100)
  description String?
  is_active   Boolean       @default(true)
  sort_order  Int           @default(0)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  contents    kam_content[]
  sector      kam_sector    @relation(fields: [sector_id], references: [id])

  @@unique([sector_id, slug])
  @@schema("public")
}

model kam_content {
  id              Int               @id @default(autoincrement())
  sector_id       Int?
  sub_sector_id   Int?
  title           String            @db.VarChar(255)
  slug            String            @unique @db.VarChar(255)
  description     String?
  content_type    ContentType
  visibility      ContentVisibility @default(PUBLIC)
  pricing_tier    PricingTier?      @default(FREE)
  price_kes       Decimal?          @db.Decimal(10, 2)
  pdf_url         String?           @db.VarChar(500)
  pdf_size        String?           @db.VarChar(20)
  powerbi_url     String?           @db.VarChar(500)
  powerbi_embed   String?
  db_query_type   String?           @db.VarChar(50)
  external_url    String?           @db.VarChar(500)
  tags            String?           @db.VarChar(500)
  keywords        String?           @db.VarChar(500)
  author          String?           @db.VarChar(100)
  published_date  DateTime?
  is_featured     Boolean           @default(false)
  is_active       Boolean           @default(true)
  view_count      Int               @default(0)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  sector_relation kam_sector?       @relation(fields: [sector_id], references: [id])
  sub_sector      kam_sub_sector?   @relation(fields: [sub_sector_id], references: [id])
  purchases       Purchase[]

  @@index([sector_id])
  @@index([sub_sector_id])
  @@index([content_type])
  @@index([visibility])
  @@index([pricing_tier])
  @@index([is_featured])
  @@schema("public")
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  name               String?
  role               String     @default("PUBLIC")
  current_session_id String?
  has_subscription   Boolean    @default(false)
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt
  password           String?    @unique @db.VarChar
  isSubscribed       Boolean?   @default(false)
  subscriptionExpiry DateTime?  @db.Timestamptz(6)
  adminLogs          AdminLog[]
  purchases          Purchase[]

  @@map("users")
  @@schema("public")
}

model Purchase {
  id             String         @id @default(cuid())
  user_id        String
  content_id     Int
  mpesa_txn_id   String         @unique
  amount         Decimal        @db.Decimal(10, 2)
  status         PurchaseStatus @default(PENDING)
  download_token String         @unique
  expires_at     DateTime?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  content        kam_content    @relation(fields: [content_id], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("purchases")
  @@schema("public")
}

model AdminLog {
  id         Int      @id @default(autoincrement())
  user_id    String
  action     String
  resource   String?  @db.VarChar(255)
  details    Json?
  ip         String?  @db.VarChar(45)
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([action])
  @@index([created_at])
  @@schema("public")
}

model icms_master {
  id                  Int       @id @default(autoincrement())
  year                Int?
  month               String?   @db.VarChar(7)
  entry_number        String?   @db.VarChar(20)
  version             Int?
  item_num            Int?
  entry_status        String?   @db.VarChar(20)
  reg_date            String?   @db.VarChar(50)
  regime              String?   @db.VarChar(10)
  cpc                 String?   @db.VarChar(10)
  quantity            Decimal?  @db.Decimal(18, 2)
  fob_value           Decimal?  @db.Decimal(18, 2)
  currency            String?   @db.VarChar(5)
  entry_currency_val  Decimal?  @db.Decimal(18, 2)
  hs_chapter          String?   @db.VarChar(5)
  hscode              String?   @db.VarChar(15)
  good_description    String?
  origin_country_code String?   @db.VarChar(5)
  origin_country      String?   @db.VarChar(50)
  country_code        String?   @db.VarChar(5)
  country_name        String?   @db.VarChar(50)
  station             String?   @db.VarChar(10)
  place_of_delivery   String?   @db.VarChar(10)
  total_tax_1         Decimal?  @db.Decimal(18, 2)
  total_tax_2         Decimal?  @db.Decimal(18, 2)
  import_duty         Decimal?  @db.Decimal(18, 2)
  import_vat          Decimal?  @db.Decimal(18, 2)
  excise              Decimal?  @db.Decimal(18, 2)
  export_levy         Decimal?  @db.Decimal(18, 2)
  idf                 Decimal?  @db.Decimal(18, 2)
  rdl                 Decimal?  @db.Decimal(18, 2)
  rml                 Decimal?  @db.Decimal(18, 2)
  prl                 Decimal?  @db.Decimal(18, 2)
  mss                 Decimal?  @db.Decimal(18, 2)
  other_tax           Decimal?  @db.Decimal(18, 2)
  created_at          DateTime? @default(now()) @db.Timestamp(6)

  @@unique([entry_number, item_num, version, reg_date, regime])
  @@unique([entry_number, item_num, version], map: "idx_icms_identity")
  @@unique([entry_number, item_num, version], map: "idx_icms_master")
  @@index([year, month])
  @@schema("customs")
}

model kam_search_log {
  id         Int      @id @default(autoincrement())
  query      String   @db.VarChar(255)
  results    Int      @default(0)
  ip_address String?  @db.VarChar(45)
  user_agent String?  @db.VarChar(500)
  created_at DateTime @default(now())

  @@index([query])
  @@index([created_at])
  @@schema("public")
}

model icms_insert_errors {
  id            Int       @id @default(autoincrement())
  error_message String?
  failed_sql    String?
  chunk_info    Json?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

model ataccount {
  id                 Int       @id @default(autoincrement())
  acctno             Int
  oldacctnum         String?   @db.VarChar(20)
  oldpremnum         String?   @db.VarChar(20)
  premiseid          Int
  customerid         Int
  bill_name          String    @db.VarChar(100)
  bill_attention     String?   @db.VarChar(50)
  bill_line1         String    @db.VarChar(100)
  bill_line2         String?   @db.VarChar(100)
  bill_city          String    @db.VarChar(50)
  bill_state         String    @db.Char(2)
  bill_zip           String    @db.VarChar(10)
  start_date         DateTime  @db.Timestamp(6)
  end_date           DateTime? @db.Timestamp(6)
  last_bill_end_date DateTime? @db.Timestamp(6)
  last_billed        DateTime  @db.Timestamp(6)
  current_balance    Decimal   @db.Decimal(9, 2)
  ytd_usage          Int
  updated            DateTime  @db.Timestamp(6)
  updateby           Int
  directpay          Boolean?
  ytd_usage_non_pot  Int
  water_state        Boolean
  do_not_mail        Boolean
  onlinepay          Boolean?
  paperless          Boolean?

  @@schema("public")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model document_chunks {
  id                  Int                   @id @default(autoincrement())
  document_id         Int
  chunk_index         Int
  chunk_text          String
  page_number         Int?
  page_number_end     Int?
  char_start          Int?
  char_end            Int?
  token_count         Int?
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  resource_documents  resource_documents    @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  document_embeddings document_embeddings[]

  @@unique([document_id, chunk_index])
  @@index([document_id, chunk_index], map: "idx_dc_chunk_index")
  @@index([document_id], map: "idx_dc_document_id")
  @@index([document_id, page_number], map: "idx_dc_page")
  @@schema("sector")
}

model document_downloads {
  id                 Int                 @id @default(autoincrement())
  document_id        Int?
  downloaded_at      DateTime?           @default(now()) @db.Timestamp(6)
  ip_address         String?             @db.VarChar(45)
  user_agent         String?
  resource_documents resource_documents? @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([document_id], map: "idx_dd_document_id")
  @@schema("sector")
}

model document_embeddings {
  id                 Int                    @id @default(autoincrement())
  chunk_id           Int
  document_id        Int
  model_name         String                 @db.VarChar(100)
  model_version      String?                @db.VarChar(50)
  dimensions         Int                    @default(1536)
  created_at         DateTime?              @default(now()) @db.Timestamp(6)
  embedding          Unsupported("vector")?
  document_chunks    document_chunks        @relation(fields: [chunk_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  resource_documents resource_documents     @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([chunk_id, model_name])
  @@index([chunk_id], map: "idx_de_chunk_id")
  @@index([document_id], map: "idx_de_document_id")
  @@index([model_name], map: "idx_de_model")
  @@schema("sector")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model document_ingest_log {
  id                 Int                 @id @default(autoincrement())
  filename           String?             @db.VarChar(255)
  status             String              @db.VarChar(20)
  document_id        Int?
  error_msg          String?
  ingest_at          DateTime?           @default(now()) @db.Timestamp(6)
  resource_documents resource_documents? @relation(fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "idx_dil_status")
  @@schema("sector")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model document_pages {
  id                 Int                @id @default(autoincrement())
  document_id        Int
  page_number        Int
  page_text          String?
  char_count         Int?
  created_at         DateTime?          @default(now()) @db.Timestamp(6)
  resource_documents resource_documents @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([document_id, page_number])
  @@index([document_id], map: "idx_dp_document_id")
  @@index([document_id, page_number], map: "idx_dp_page")
  @@schema("sector")
}

model resource_documents {
  id                      Int                   @id @default(autoincrement())
  title                   String                @db.VarChar(500)
  sector                  String?               @db.VarChar(100)
  document_type           String?               @db.VarChar(100)
  publisher               String?               @default("KAM") @db.VarChar(255)
  year                    Int?
  description             String?
  tags                    String[]
  file_data               Bytes?
  filename                String                @db.VarChar(255)
  original_filename       String?               @db.VarChar(255)
  was_converted           Boolean?              @default(false)
  file_size_bytes         Int?
  mime_type               String?               @default("application/pdf") @db.VarChar(50)
  sharepoint_file_id      String?               @unique @db.VarChar(255)
  ingest_source           String?               @default("n8n_sharepoint") @db.VarChar(100)
  uploaded_by             String?               @default("n8n_workflow") @db.VarChar(255)
  extraction_status       String?               @default("pending") @db.VarChar(20)
  extraction_error        String?
  chunk_count             Int?                  @default(0)
  page_count              Int?                  @default(0)
  extracted_at            DateTime?             @db.Timestamp(6)
  is_published            Boolean?              @default(false)
  is_active               Boolean?              @default(true)
  download_count          Int?                  @default(0)
  created_at              DateTime?             @default(now()) @db.Timestamp(6)
  updated_at              DateTime?             @default(now()) @db.Timestamp(6)
  sharepoint_download_url String?
  folder_category         String?               @db.VarChar(255)
  document_chunks         document_chunks[]
  document_downloads      document_downloads[]
  document_embeddings     document_embeddings[]
  document_ingest_log     document_ingest_log[]
  document_pages          document_pages[]
  resource_logs           resource_log[]

  @@index([document_type], map: "idx_rd_doc_type")
  @@index([extraction_status], map: "idx_rd_extraction")
  @@index([is_published, is_active], map: "idx_rd_published")
  @@index([sector], map: "idx_rd_sector")
  @@index([sharepoint_file_id], map: "idx_rd_sp_file_id")
  @@index([tags], map: "idx_rd_tags", type: Gin)
  @@index([year], map: "idx_rd_year")
  @@schema("sector")
}

model ResourceDocuments {
  id                      Int                         @id
  title                   String                      @db.VarChar(500)
  sector                  String?                     @db.VarChar(100)
  document_type           String?                     @db.VarChar(100)
  publisher               String?                     @default("KAM") @db.VarChar(255)
  year                    Int?
  description             String?
  tags                    String[]
  file_data               Bytes?
  filename                String                      @db.VarChar(255)
  original_filename       String?                     @db.VarChar(255)
  was_converted           Boolean?                    @default(false)
  file_size_bytes         Int?
  mime_type               String?                     @default("application/pdf") @db.VarChar(50)
  sharepoint_file_id      String?                     @unique @db.VarChar(255)
  ingest_source           String?                     @default("n8n_sharepoint") @db.VarChar(100)
  uploaded_by             String?                     @default("n8n_workflow") @db.VarChar(255)
  extraction_status       String?                     @default("pending") @db.VarChar(20)
  extraction_error        String?
  chunk_count             Int?                        @default(0)
  page_count              Int?                        @default(0)
  extracted_at            DateTime?                   @db.Timestamp(6)
  is_published            Boolean?                    @default(false)
  is_active               Boolean?                    @default(true)
  download_count          Int?                        @default(0)
  created_at              DateTime?                   @default(now()) @db.Timestamp(6)
  updated_at              DateTime?                   @default(now()) @db.Timestamp(6)
  sharepoint_download_url String?
  folder_category         String?                     @db.VarChar(255)
  document_chunks         trade_document_chunks[]
  document_downloads      trade_document_downloads[]
  document_embeddings     trade_document_embeddings[]
  document_ingest_log     trade_document_ingest_log[]
  document_pages          trade_document_pages[]

  @@index([document_type], map: "idx_rd_doc_type")
  @@index([extraction_status], map: "idx_rd_extraction")
  @@index([is_published, is_active], map: "idx_rd_published")
  @@index([sector], map: "idx_rd_sector")
  @@index([sharepoint_file_id], map: "idx_rd_sp_file_id")
  @@index([tags], map: "idx_rd_tags", type: Gin)
  @@index([year], map: "idx_rd_year")
  @@map("resource_documents")
  @@schema("trade")
}

model debt {
  id             BigInt   @id @default(autoincrement())
  country_iso3   String   @db.Char(3)
  country_name   String
  year           Int      @db.SmallInt
  value          Decimal? @db.Decimal(20, 6)
  indicator_code String
  indicator_name String?
  source         String?
  is_projection  Boolean  @default(false)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  @@unique([indicator_code, country_iso3, year])
  @@index([indicator_code], map: "ix_debt_indicator")
  @@index([country_iso3], map: "ix_debt_iso3")
  @@index([year], map: "ix_debt_year")
  @@schema("macro_data")
}

model exchange_rates {
  id              BigInt   @id @default(autoincrement())
  date            DateTime @db.Date
  base_currency   String   @db.Char(3)
  target_currency String   @db.Char(3)
  rate            Decimal  @db.Decimal(20, 8)
  source          String?
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([date, base_currency, target_currency])
  @@index([date], map: "ix_er_date")
  @@index([date, target_currency], map: "ix_er_date_target")
  @@index([target_currency], map: "ix_er_target")
  @@schema("macro_data")
}

model indicators {
  id             BigInt   @default(autoincrement())
  indicator_code String
  indicator_name String?
  country_iso2   String?
  country_iso3   String
  country_name   String?
  year           Int
  value          Decimal? @db.Decimal
  unit           String?
  obs_status     String?
  inserted_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  @@id([indicator_code, country_iso3, year], map: "pk_macro_data_indicators")
  @@index([country_iso3], map: "idx_wb_country")
  @@index([country_iso3, year], map: "idx_wb_country_year")
  @@index([indicator_code], map: "idx_wb_indicator")
  @@index([year], map: "idx_wb_year")
  @@schema("macro_data")
}

model inflation {
  id             BigInt   @default(autoincrement())
  country_iso3   String
  country_name   String?
  year           Int
  value          Decimal? @db.Decimal
  indicator_code String?  @default("PCPIPCH")
  indicator_name String?  @default("Inflation rate, average consumer prices (annual %)")
  source         String?
  is_projection  Boolean? @default(false)
  inserted_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  @@id([country_iso3, year], map: "pk_macro_data_inflation")
  @@index([country_iso3], map: "idx_imf_country")
  @@index([year], map: "idx_imf_year")
  @@schema("macro_data")
}

model ingest_errors {
  id            BigInt    @id @default(autoincrement())
  error_message String?
  failed_sql    String?
  chunk_info    Json?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@schema("macro_data")
}

model ingest_errors_debt {
  id            BigInt   @id @default(autoincrement())
  error_message String?
  failed_sql    String?
  chunk_info    Json?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@schema("macro_data")
}

model ingest_errors_inflation {
  id            BigInt    @id @default(autoincrement())
  error_message String?
  failed_sql    String?
  chunk_info    Json?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@schema("macro_data")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model trade_document_chunks {
  id                  Int                         @id
  document_id         Int
  chunk_index         Int
  chunk_text          String
  page_number         Int?
  page_number_end     Int?
  char_start          Int?
  char_end            Int?
  token_count         Int?
  created_at          DateTime?                   @default(now()) @db.Timestamp(6)
  resource_documents  ResourceDocuments           @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  document_embeddings trade_document_embeddings[]

  @@unique([document_id, chunk_index])
  @@index([document_id, chunk_index], map: "idx_dc_chunk_index")
  @@index([document_id], map: "idx_dc_document_id")
  @@index([document_id, page_number], map: "idx_dc_page")
  @@map("document_chunks")
  @@schema("trade")
}

model trade_document_downloads {
  id                 Int                @id
  document_id        Int?
  downloaded_at      DateTime?          @default(now()) @db.Timestamp(6)
  ip_address         String?            @db.VarChar(45)
  user_agent         String?
  resource_documents ResourceDocuments? @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([document_id], map: "idx_dd_document_id")
  @@map("document_downloads")
  @@schema("trade")
}

model trade_document_embeddings {
  id                 Int                   @id(map: "trade_document_embeddings_pkey") @default(autoincrement())
  chunk_id           Int
  document_id        Int
  model_name         String                @db.VarChar(100)
  model_version      String?               @db.VarChar(50)
  dimensions         Int                   @default(768)
  embedding          Unsupported("vector")
  created_at         DateTime?             @default(now()) @db.Timestamp(6)
  document_chunks    trade_document_chunks @relation(fields: [chunk_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "trade_document_embeddings_chunk_id_fkey")
  resource_documents ResourceDocuments     @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "trade_document_embeddings_document_id_fkey")

  @@unique([chunk_id, model_name], map: "trade_document_embeddings_chunk_id_model_name_key")
  @@index([chunk_id], map: "idx_trade_de_chunk_id")
  @@index([document_id], map: "idx_trade_de_document_id")
  @@index([model_name], map: "idx_trade_de_model")
  @@index([embedding], map: "idx_trade_embeddings_hnsw")
  @@map("document_embeddings")
  @@schema("trade")
}

model trade_document_ingest_log {
  id                 Int                @id
  filename           String?            @db.VarChar(255)
  status             String             @db.VarChar(20)
  document_id        Int?
  error_msg          String?
  ingest_at          DateTime?          @default(now()) @db.Timestamp(6)
  resource_documents ResourceDocuments? @relation(fields: [document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "idx_dil_status")
  @@map("document_ingest_log")
  @@schema("trade")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model trade_document_pages {
  id                 Int               @id
  document_id        Int
  page_number        Int
  page_text          String?
  char_count         Int?
  created_at         DateTime?         @default(now()) @db.Timestamp(6)
  resource_documents ResourceDocuments @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([document_id, page_number])
  @@index([document_id], map: "idx_dp_document_id")
  @@index([document_id, page_number], map: "idx_dp_page")
  @@map("document_pages")
  @@schema("trade")
}

model cbk_central_bank_rates {
  id                       Int       @id @default(autoincrement())
  year                     Int
  month                    String
  period_date              DateTime  @db.Date
  repo_rate                Decimal?  @db.Decimal(8, 4)
  reverse_repo_rate        Decimal?  @db.Decimal(8, 4)
  interbank_rate           Decimal?  @db.Decimal(8, 4)
  tbill_91_day             Decimal?  @db.Decimal(8, 4)
  tbill_182_day            Decimal?  @db.Decimal(8, 4)
  tbill_364_day            Decimal?  @db.Decimal(8, 4)
  cash_reserve_requirement Decimal?  @db.Decimal(8, 4)
  central_bank_rate        Decimal?  @db.Decimal(8, 4)
  synced_at                DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([year, month])
  @@schema("macro_data")
}

